FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      C_O2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

#include "inletOxygen"

internalField   uniform $inletOxygen;

boundaryField
{

    ".*"
    {
        type            zeroGradient;
    }
    
    "channelOutlet"
    {
    type            zeroGradient;
    }
    
    "channelInlet"
    {
    type fixedValue;
    value uniform $inletOxygen;
    
    //type            zeroGradient;
    
    }
 
 catalyst
    {

    type            codedMixed;
    
    refValue        $internalField;
    refGradient     uniform 0;
    valueFraction   uniform 1;

    name    cathode_reduction;   // name of generated BC

    code
    #{
        const fvPatch& p = this->patch(); 
    	label patchID = p.patch().boundaryMesh().findPatchID("catalyst");         
        const fvMesh& mesh = patch().boundaryMesh().mesh();

	const dictionary& speciesProperties = db().lookupObject<IOdictionary>("speciesProperties");           
	
	const volScalarField& porosityField = this->db().objectRegistry::template lookupObject<volScalarField>("porosity");
    	const dimensionedScalar Dif_O2(speciesProperties.subDict("O2").lookup("D"));
        //const scalar Deff_O2 = Dif_O2.value();
        scalarField porosity_boundary = porosityField.boundaryField()[patchID];
         
            
	const volScalarField& C_O2 = this->db().objectRegistry::template lookupObject<volScalarField>("C_O2");
        scalarField C_O2_boundary = C_O2.boundaryField()[patchID]; 
        const volScalarField& Flux = this->db().objectRegistry::template lookupObject<volScalarField>("Flux");
        scalarField Flux_boundary = Flux.boundaryField()[patchID]; 
        scalarField delta = 1.0/mesh.deltaCoeffs().boundaryField()[patchID]; 
        
        const dictionary& kineticProperties = db().lookupObject<IOdictionary>("transportProperties");
        const dictionary& Results = db().lookupObject<IOdictionary>("Results");
        const scalar C_0 = readScalar(kineticProperties.lookup("C_0"));
        //const scalar tau = readScalar(kineticProperties.lookup("tau"));
        //const dimensionedScalar tau = kineticProperties.lookup("tau");
        const dimensionedScalar tau(kineticProperties.lookup("tau"));
	const scalar F = 96485;
	
	scalarField Deff_O2 = Dif_O2.value()*porosity_boundary/tau.value();
	
        scalarField j_1 = Flux_boundary;
       
     
        scalarField a = (delta/(Deff_O2*4*F)) * (j_1/C_O2_boundary);
        scalarField b = j_1*0; //it is actually zero, but need field with same dimensions as ak
        scalarField gradC1 = j_1/(4*Deff_O2*F);
        
        this->refValue() = b/a; // 0 if production
        this->refGrad() = gradC1*0; // this is zero if consumption
        this->valueFraction() = a/(a+1); // 0 if production
    
        
    #};   
 
    codeInclude
    #{
        #include "fvCFD.H"
        #include "fvcSnGrad.H"
    #};

    codeOptions
    #{
        -I$(LIB_SRC)/finiteVolume/lnInclude \
            -I$(LIB_SRC)/meshTools/lnInclude
    #};
    
    
      }   

}


