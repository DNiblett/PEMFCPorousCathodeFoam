FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      fi;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//dimensions      [1 2 -3 0 0 -1 0];
dimensions      [0 0 0 0 0 0 0];

//#include "BCinput"
#include "../constant/appliedCurrent"

internalField   uniform 0;

boundaryField
{


".*"
{
type zeroGradient;
}

// The cathode Newton loop updates fi directly on this patch.  Keep it as an
// explicit value patch so the resulting face potential is written for
// visualisation, rather than being reconstructed as zeroGradient from the
// zero internal field.
catalyst
{
    type  fixedValue;
    value uniform 0;
}

}


